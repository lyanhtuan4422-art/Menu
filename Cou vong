--====================================================
-- ANTI BYPASS
--====================================================

spawn(function()

    while task.wait(10) do

        local Data =
        Keys[InputKey]

        if not Data then

            LocalPlayer:Kick(
            "❌ Key Deleted"
            )

        end

        -- CHECK HWID
        if Data.hwid ~= HWID then

            LocalPlayer:Kick(
            "⛔ Phát Hiện Đổi Thiết Bị"
            )

        end

        -- CHECK IP
        if Data.ip ~= IP then

            LocalPlayer:Kick(
            "⛔ Phát Hiện Đổi IP"
            )

        end

    end

end)

