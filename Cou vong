--//====================================================
--// TUẤN SICRIP
--// KEY SYSTEM + HWID LOCK + IP LOCK
--//====================================================

local Rayfield =
loadstring(game:HttpGet(
'https://sirius.menu/rayfield'
))()

local Players =
game:GetService("Players")

local AnalyticsService =
game:GetService("RbxAnalyticsService")

local LocalPlayer =
Players.LocalPlayer

--====================================================
-- HWID + IP
--====================================================

local HWID =
AnalyticsService:GetClientId()

local IP =
game:HttpGet("https://api.ipify.org")

--====================================================
-- DATABASE
--====================================================

local Keys = {

    ["TUAN-15K"] = {

        hwid = nil,
        ip = nil,
        level = "15K"

    },

    ["TUAN-20K"] = {

        hwid = nil,
        ip = nil,
        level = "20K"

    },

    ["TUAN-25K"] = {

        hwid = nil,
        ip = nil,
        level = "25K"

    },

    ["BANANA-75K"] = {

        hwid = nil,
        ip = nil,
        level = "75K"

    }

}

--====================================================
-- HIDE KEY
--====================================================

local function HideKey(Key)

    local Start =
    string.sub(Key,1,5)

    local End =
    string.sub(Key,-3)

    return Start.."********"..End
end

--====================================================
-- CHECK SYSTEM
--====================================================

local function CheckKey(Key)

    local Data =
    Keys[Key]

    -- KEY SAI
    if not Data then

        return false,
        "❌ Key Không Hợp Lệ"

    end

    -- CHƯA BIND
    if not Data.hwid then

        Data.hwid = HWID
        Data.ip = IP

        return true,
        "✅ Đăng Ký Máy Thành Công"

    end

    -- CHECK HWID
    if Data.hwid ~= HWID then

        return false,
        "⛔ HWID Không Khớp"

    end

    -- CHECK IP
    if Data.ip ~= IP then

        return false,
        "⛔ IP Không Khớp"

    end

    return true,
    "✅ Đăng Nhập Thành Công"

end

--====================================================
-- WINDOW
--====================================================

local Window =
Rayfield:CreateWindow({

   Name = "Tuấn Sicrip",

   LoadingTitle = "Tuấn Sicrip",

   LoadingSubtitle = "Premium Hub",

   ConfigurationSaving = {
      Enabled = false,
   },

   Discord = {
      Enabled = false,
   },

   KeySystem = true,

   KeySettings = {

      Title = "🔐 Tuấn Sicrip Key",

      Subtitle = "Nhập Key",

      Note = "Liên hệ mua key",

      FileName = "TuanKey",

      SaveKey = true,

      GrabKeyFromSite = false,

      Key = {

         "TUAN-15K",
         "TUAN-20K",
         "TUAN-25K",
         "BANANA-75K"

      }
   }
})

--====================================================
-- INPUT KEY
--====================================================

local InputKey =
Rayfield.LoadedKey

local Success, Message =
CheckKey(InputKey)

if not Success then

    LocalPlayer:Kick(Message)

    return
end

