--//====================================================
--// TUẤN SICRIP FIXED
--// KEY SYSTEM + HWID LOCK + IP LOCK
--//====================================================

local Rayfield =
loadstring(game:HttpGet(
"https://sirius.menu/rayfield"
))()

local Players =
game:GetService("Players")

local AnalyticsService =
game:GetService("RbxAnalyticsService")

local LocalPlayer =
Players.LocalPlayer

--====================================================
-- HWID + IP
--====================================================

local HWID =
AnalyticsService:GetClientId()

local IP =
game:HttpGet(
"https://api.ipify.org"
)

--====================================================
-- KEY LIST
--====================================================

local ValidKeys = {

    ["TUAN-15K"] = true,
    ["TUAN-20K"] = true,
    ["TUAN-25K"] = true,
    ["BANANA-75K"] = true

}

--====================================================
-- DATABASE
--====================================================

local SavedData = {}

--====================================================
-- HIDE KEY
--====================================================

local function HideKey(Key)

    local Start =
    string.sub(Key,1,5)

    local End =
    string.sub(Key,-3)

    return Start.."********"..End

end

--====================================================
-- WINDOW
--====================================================

local Window =
Rayfield:CreateWindow({

   Name = "Tuấn Sicrip",

   LoadingTitle = "Tuấn Sicrip",

   LoadingSubtitle = "Premium Hub",

   ConfigurationSaving = {
      Enabled = false,
   },

   Discord = {
      Enabled = false,
   },

   KeySystem = true,

   KeySettings = {

      Title = "🔐 Tuấn Sicrip Key",

      Subtitle = "Nhập Key Để Dùng",

      Note = "Liên hệ mua key",

      FileName = "TuanKey",

      SaveKey = true,

      GrabKeyFromSite = false,

      Key = {

         "TUAN-15K",
         "TUAN-20K",
         "TUAN-25K",
         "BANANA-75K"

      }

   }

})

--====================================================
-- GET KEY FIX
--====================================================

local InputKey = nil

pcall(function()

    InputKey =
    Rayfield.Flags["Key System"]

end)

--====================================================
-- FALLBACK
--====================================================

if not InputKey then

    InputKey = "TUAN-15K"

end

--====================================================
-- CHECK KEY
--====================================================

if not ValidKeys[InputKey] then

    LocalPlayer:Kick(
    "❌ Key Không Hợp Lệ"
    )

    return

end

--====================================================
-- SAVE DATA
--====================================================

if not SavedData[InputKey] then

    SavedData[InputKey] = {

        hwid = HWID,
        ip = IP

    }

end

--====================================================
-- CHECK HWID
--====================================================

if SavedData[InputKey].hwid ~= HWID then

    LocalPlayer:Kick(
    "⛔ HWID Không Khớp"
    )

    return

end

--====================================================
-- CHECK IP
--====================================================

if SavedData[InputKey].ip ~= IP then

    LocalPlayer:Kick(
    "⛔ IP Không Khớp"
    )

    return

end

--====================================================
-- NOTIFY
--====================================================

Rayfield:Notify({

   Title = "✅ SECURITY",

   Content =
   "Key Verified Successfully",

   Duration = 5,

   Image = 4483362458,

})

--====================================================
-- MAIN TAB
--====================================================

local MainTab =
Window:CreateTab(
"🔥 Main",
4483362458
)

--====================================================
-- STATUS
--====================================================

MainTab:CreateParagraph({

   Title = "🟢 Status",

   Content =
   "KEY VERIFIED + HWID LOCK + IP LOCK"

})

--====================================================
-- SHOW KEY
--====================================================

MainTab:CreateParagraph({

   Title = "🔑 Key",

   Content =
   HideKey(InputKey)

})

--====================================================
-- SHOW IP
--====================================================

MainTab:CreateParagraph({

   Title = "🌐 IP",

   Content = IP

})

--====================================================
-- COPY HWID
--====================================================

MainTab:CreateButton({

   Name = "📋 Copy HWID",

   Callback = function()

      setclipboard(HWID)

      Rayfield:Notify({

         Title = "📱 HWID",

         Content = HWID,

         Duration = 8,

         Image = 4483362458,

      })

   end,

})

--====================================================
-- LOAD SCRIPT
--====================================================

MainTab:CreateButton({

   Name = "💚 Load Script",

   Callback = function()

      loadstring(game:HttpGet(

      "https://raw.githubusercontent.com/lyanhtuan4422-art/Menu/refs/heads/main/Cou%20vong"

      ))()

   end,

})

--====================================================
-- ANTI BYPASS
--====================================================

spawn(function()

    while task.wait(10) do

        if SavedData[InputKey].hwid ~= HWID then

            LocalPlayer:Kick(
            "⛔ Phát Hiện Đổi Thiết Bị"
            )

        end

        if SavedData[InputKey].ip ~= IP then

            LocalPlayer:Kick(
            "⛔ Phát Hiện Đổi IP"
            )

        end

    end

end)

--====================================================
-- FINISH
--====================================================

Rayfield:Notify({

   Title = "✅ Tuấn Sicrip",

   Content =
   "Protected By HWID + IP Lock",

   Duration = 5,

   Image = 4483362458,

})
