--// SYSTEM KEY ROBLOX
--// 1 KEY = 1 MÁY + IP LOCK

local Analytics = game:GetService("RbxAnalyticsService")

--========================
-- LẤY HWID + IP
--========================

local HWID = Analytics:GetClientId()

local IP = "UNKNOWN"

pcall(function()
    IP = game:HttpGet("https://api.ipify.org")
end)

--========================
-- DATABASE KEY
--========================
-- [KEY] = {
--     HWID = "",
--     IP = ""
-- }

local Keys = {
    ["VIP-123456"] = {
        HWID = nil,
        IP = nil
    },

    ["VIP-PRO999"] = {
        HWID = nil,
        IP = nil
    }
}

--========================
-- GUI
--========================

local ScreenGui = Instance.new("ScreenGui")
local Frame = Instance.new("Frame")
local TextBox = Instance.new("TextBox")
local Button = Instance.new("TextButton")

ScreenGui.Parent = game.CoreGui

Frame.Parent = ScreenGui
Frame.Size = UDim2.new(0,300,0,150)
Frame.Position = UDim2.new(0.5,-150,0.5,-75)
Frame.BackgroundColor3 = Color3.fromRGB(35,35,35)

TextBox.Parent = Frame
TextBox.Size = UDim2.new(0,250,0,40)
TextBox.Position = UDim2.new(0.5,-125,0.2,0)
TextBox.PlaceholderText = "Nhập key..."

Button.Parent = Frame
Button.Size = UDim2.new(0,250,0,40)
Button.Position = UDim2.new(0.5,-125,0.6,0)
Button.Text = "Xác nhận"

--========================
-- CHECK KEY
--========================

Button.MouseButton1Click:Connect(function()

    local InputKey = TextBox.Text

    -- key không tồn tại
    if not Keys[InputKey] then
        Button.Text = "Key sai!"
        return
    end

    local Data = Keys[InputKey]

    -- lần đầu dùng key
    if Data.HWID == nil then
        Data.HWID = HWID
        Data.IP = IP
    end

    -- khác máy
    if Data.HWID ~= HWID then
        Button.Text = "Sai thiết bị!"
        return
    end

    -- khác IP
    if Data.IP ~= IP then
        Button.Text = "Sai IP!"
        return
    end

    -- đúng key
    Button.Text = "Đang tải..."
    wait(1)

    ScreenGui:Destroy()

    loadstring(game:HttpGet(
        "https://raw.githubusercontent.com/lyanhtuan4422-art/Cc/refs/heads/main/Scriptdemo.lua%20(2).txt.bak"
    ))()

end)
